# apps/api — copy to .env for local dev. NEVER commit real secrets (Plan/02 §5.7).
PORT=4000
NODE_ENV=development

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://hotel:hotel_dev_password@localhost:5432/hotel

# Redis (matches docker-compose.yml)
REDIS_URL=redis://:redis_dev_password@localhost:6379

# Auth (Phase 4) — placeholders only
JWT_ACCESS_SECRET=changeme_dev_only
JWT_REFRESH_SECRET=changeme_dev_only
# Separate secret for booking-action verification tokens (Phase 8) — MUST differ
# from JWT_ACCESS_SECRET so those tokens can never be used as access tokens.
JWT_BOOKING_SECRET=changeme_dev_only_booking

# CORS (browser clients) — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# AI assistant webhook HMAC secret (Phase 8) — shared with ElevenLabs
AI_WEBHOOK_SECRET=

# Third-party (real values via Secrets Manager, not here) — Phase 8
TELNYX_API_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
