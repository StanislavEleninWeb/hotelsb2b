# apps/web — copy to .env.local for local dev. NEVER commit real secrets.
# Base URL of the NestJS API (server-side calls).
API_BASE_URL=http://localhost:4000/api/v1
# Public API base URL (browser calls). Only expose non-secret values via NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
