 apps/staff — copy to .env.local for local dev. NEVER commit real secrets.
 apps/web # Browser + SSR API base (versioned).
 apps/web NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
 apps/web API_BASE_URL=http://localhost:4000/api/v1
 apps/web # API origin (scheme+host) for the CSP connect-src allow-list.
 apps/web NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
